{
  "name": "buddies-spa-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run audit:phases && prisma generate && prisma migrate deploy && next build",
    "build:ci": "npm run audit:phases && prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:fast",
    "test:watch": "vitest",
    "test:fast": "vitest run tests/unit tests/component tests/integration tests/contracts",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:integration": "vitest run tests/integration",
    "test:contracts": "vitest run tests/contracts",
    "test:coverage": "vitest run --coverage tests/unit tests/component tests/integration tests/contracts",
    "test:database": "node scripts/assert-test-database.mjs && vitest run --config vitest.database.config.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:audit": "node scripts/report-test-suite.mjs",
    "test:ci": "npm run test:audit && npm run test:coverage",
    "test:all": "npm run test:ci && npm run test:database && npm run test:e2e",
    "audit:phases": "node scripts/verify-phase-contracts.mjs",
    "check": "npm run audit:phases && npm run typecheck && npm run lint && npm run test:fast && npm run build:ci",
    "smoke:production": "node scripts/smoke-production.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@prisma/client": "^6.19.3",
    "@upstash/redis": "^1.34.0",
    "@vercel/analytics": "^2.0.1",
    "ably": "^2.9.0",
    "mapbox-gl": "^3.12.0",
    "next": "^15.5.20",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-map-gl": "^8.0.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.4.21",
    "dotenv": "16.6.1",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.5.20",
    "jsdom": "30.0.1",
    "postcss": "^8.5.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  }
}
