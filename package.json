{
  "name": "buddies-spa-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run prisma:prepare && next dev",
    "build": "npm run audit:phases && npm run prisma:prepare && prisma generate && prisma migrate deploy && next build",
    "build:ci": "npm run audit:phases && npm run prisma:prepare && prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit:phases": "node scripts/verify-phase-contracts.mjs",
    "check": "npm run audit:phases && npm run prisma:prepare && npm run typecheck && npm run lint && npm run build:ci",
    "smoke:production": "node scripts/smoke-production.mjs",
    "prisma:prepare": "node scripts/prepare-prisma-7.mjs",
    "prisma:generate": "npm run prisma:prepare && prisma generate",
    "prisma:validate": "npm run prisma:prepare && prisma validate",
    "prisma:migrate": "npm run prisma:prepare && prisma migrate dev",
    "prisma:deploy": "npm run prisma:prepare && prisma migrate deploy",
    "prisma:push": "npm run prisma:prepare && prisma db push",
    "prisma:studio": "npm run prisma:prepare && prisma studio",
    "db:seed": "npm run prisma:prepare && prisma db seed",
    "db:reset": "npm run prisma:prepare && prisma migrate reset"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@upstash/redis": "^1.34.0",
    "ably": "^2.9.0",
    "dotenv": "^17.0.0",
    "mapbox-gl": "^3.12.0",
    "next": "^15.5.20",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-map-gl": "^8.0.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.5.3",
    "prisma": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  }
}
