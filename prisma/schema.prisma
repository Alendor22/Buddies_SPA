generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  WALKER
  ADMIN
}

enum DogCustodianRole {
  OWNER
  CAREGIVER
  WALKER
  VIEWER
}

enum DogIdentifierType {
  QR
  MICROCHIP
  VISUAL_RECOGNITION
  NFC
  BLE
}

enum ConsentType {
  LOCATION_SHARING
  MEDICAL_ACCESS
  SCANNER_DISCLOSURE
  MARKETPLACE_ACCESS
  PHOTO_USAGE
  RECOGNITION_ENROLLMENT
}

enum DogStatus {
  SAFE
  LOST
  FOUND
}

enum WalkStatus {
  REQUESTED
  ACCEPTED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BuddyRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum WalkInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum NotificationType {
  BUDDY_REQUEST
  WALK_INVITE
  WALK_STATUS
  MESSAGE
  DOG_LOST
  DOG_FOUND
  DOG_SIGHTING
  VET_REMINDER
  SYSTEM
}

enum DogPresenceStatus {
  NOT_ACTIVE
  LIKELY_WALKING
  WALKING
  PAUSED
  STALE
  POSSIBLY_DRIVING
}

enum MapReportType {
  FRIENDLY_GROUP
  LOOSE_DOG
  AGGRESSIVE_DOG
  WATER_BOWL
  POOP_BAG_STATION
  HAZARD
  CROWDED_PARK
  LOST_SIGHTING
}

enum RecognitionCaptureView {
  FRONT_LEFT
  FRONT_CENTER
  FRONT_RIGHT
  REAR_LEFT
  REAR_CENTER
  REAR_RIGHT
  LEFT_HEAD_ON
  RIGHT_HEAD_ON
}

enum RecognitionEnrollmentStatus {
  PENDING
  ACTIVE
  PAUSED
  REVOKED
}

enum RecognitionAssetStatus {
  PENDING
  PROCESSING
  READY
  REJECTED
  DELETED
}

enum RecognitionEventOutcome {
  MATCH
  LOW_CONFIDENCE
  NO_MATCH
  ERROR
}

model User {
  id                       String                  @id @default(cuid())
  clerkId                  String?                 @unique
  email                    String                  @unique
  displayName              String
  passwordHash             String?
  role                     UserRole                @default(OWNER)
  emailVerifiedAt          DateTime?
  sessionVersion           Int                     @default(0)
  avatarUrl                String?
  bio                      String?
  city                     String?
  phone                    String?
  latitude                 Float?
  longitude                Float?
  dogs                     Dog[]
  preferences              UserPreference?
  householdMemberships     HouseholdMember[]
  custodianships           DogCustodian[]
  grantedConsents          ConsentGrant[]          @relation("ConsentGrantor")
  grantedShares            DogShareGrant[]         @relation("DogShareGrantor")
  auditEvents              AuditEvent[]
  recognitionEnrollments   RecognitionEnrollment[] @relation("RecognitionEnrollmentOwner")
  sentWalks                Walk[]                  @relation("RequesterWalks")
  assignedWalks            Walk[]                  @relation("WalkerWalks")
  messages                 Message[]
  vetRecords               VetRecord[]
  favoriteRoutes           FavoriteRoute[]
  notifications            Notification[]
  sentBuddyRequests        BuddyRequest[]          @relation("SentBuddyRequests")
  receivedBuddyRequests    BuddyRequest[]          @relation("ReceivedBuddyRequests")
  buddyLinksA              Buddy[]                 @relation("BuddyUserA")
  buddyLinksB              Buddy[]                 @relation("BuddyUserB")
  dogPresences             DogPresence[]
  mapReports               MapReport[]
  socialPrivacy            SocialPrivacy?
  socialBlocksMade         SocialBlock[]           @relation("SocialBlocker")
  socialBlocksReceived     SocialBlock[]           @relation("SocialBlocked")
  checkIns                 CheckIn[]
  conversationMemberships  ConversationMember[]
  socialMessages           SocialMessage[]
  ownedSocialGroups        SocialGroup[]
  socialGroupMemberships   SocialGroupMember[]
  activityFeedItems        ActivityFeedItem[]
  hostedSocialEvents       SocialEvent[]
  socialEventAttendance    SocialEventAttendee[]
  reputationEvents         ReputationEvent[]       @relation("ReputationSubject")
  reputationActions        ReputationEvent[]       @relation("ReputationActor")
  moderationReportsFiled   ModerationReport[]      @relation("ModerationReporter")
  moderationReportsAgainst ModerationReport[]      @relation("ModerationTargetUser")
  metaConnections          MetaConnection[]
  metaOAuthStates          MetaOAuthState[]
  metaShares               MetaShare[]
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
}

model UserPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme               String   @default("system")
  locale              String   @default("en")
  marketingEmails     Boolean  @default(false)
  safetyAlerts        Boolean  @default(true)
  marketplaceMessages Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Household {
  id        String            @id @default(cuid())
  name      String
  members   HouseholdMember[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model HouseholdMember {
  id          String    @id @default(cuid())
  householdId String
  userId      String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([householdId, userId])
  @@index([userId])
}

model DogCustodian {
  id        String           @id @default(cuid())
  dogId     String
  userId    String
  role      DogCustodianRole @default(VIEWER)
  dog       Dog              @relation(fields: [dogId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([dogId, userId])
  @@index([userId, role])
  @@index([dogId, role])
}

model Dog {
  id                       String                  @id @default(cuid())
  ownerId                  String
  owner                    User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                     String
  slug                     String                  @unique
  publicId                 String?                 @default(cuid())
  breed                    String?
  birthDate                DateTime?
  weightLbs                Int?
  gender                   String?
  photoUrl                 String?
  status                   DogStatus               @default(SAFE)
  temperament              String?
  medicalNotes             String?
  vaccinationNotes         String?
  emergencyContact         String?
  lostSince                DateTime?
  lastSeenLocation         String?
  lostReward               String?
  lostNotes                String?
  spayedNeutered           Boolean                 @default(false)
  friendlyDogs             Boolean                 @default(true)
  friendlyCats             Boolean                 @default(false)
  friendlyChildren         Boolean                 @default(true)
  latitude                 Float?
  longitude                Float?
  custodians               DogCustodian[]
  media                    DogMedia[]
  medicalProfile           DogMedicalProfile?
  vaccinations             Vaccination[]
  identifiers              DogIdentifier[]
  emergencyContacts        DogEmergencyContact[]
  consents                 ConsentGrant[]
  shareGrants              DogShareGrant[]
  recognitionEnrollment    RecognitionEnrollment?  @relation("RecognitionEnrollmentDog")
  recognitionEvents        RecognitionEvent[]      @relation("RecognitionMatchedDog")
  qrScans                  QrScan[]
  sightings                Sighting[]
  walks                    Walk[]
  vetRecords               VetRecord[]
  favoriteRoutes           FavoriteRoute[]
  sentWalkInvitations      WalkInvitation[]        @relation("WalkInviteSenderDog")
  receivedWalkInvitations  WalkInvitation[]        @relation("WalkInviteInvitedDog")
  sentDogBuddyRequests     DogBuddyRequest[]       @relation("SentDogBuddyRequests")
  receivedDogBuddyRequests DogBuddyRequest[]       @relation("ReceivedDogBuddyRequests")
  dogBuddyLinksA           DogBuddy[]              @relation("DogBuddyA")
  dogBuddyLinksB           DogBuddy[]              @relation("DogBuddyB")
  presences                DogPresence[]
  routeMemories            RouteMemory[]
  mapReports               MapReport[]
  notifications            Notification[]
  checkIns                 CheckIn[]
  activityFeedItems        ActivityFeedItem[]
  socialMessages           SocialMessage[]         @relation("SocialMessageSenderDog")
  receivedSocialMessages   SocialMessage[]         @relation("SocialMessageRecipientDog")
  metaDeliveries           MetaDelivery[]
  moderationReports        ModerationReport[]
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([publicId])
}

model DogMedia {
  id        String   @id @default(cuid())
  dogId     String
  dog       Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  kind      String   @default("PHOTO")
  url       String
  width     Int?
  height    Int?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([dogId, isPrimary])
  @@index([dogId, createdAt])
}

model DogMedicalProfile {
  id                  String   @id @default(cuid())
  dogId               String   @unique
  dog                 Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  allergies           String?
  medications         String?
  conditions          String?
  dietaryRestrictions String?
  veterinarianName    String?
  veterinarianPhone   String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Vaccination {
  id             String   @id @default(cuid())
  dogId          String
  dog            Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  name           String
  administeredAt DateTime?
  expiresAt      DateTime?
  documentUrl    String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([dogId, expiresAt])
  @@index([dogId, name])
}

model DogIdentifier {
  id            String            @id @default(cuid())
  dogId         String
  dog           Dog               @relation(fields: [dogId], references: [id], onDelete: Cascade)
  type          DogIdentifierType
  hashAlgorithm String            @default("sha256")
  valueHash     String
  label         String?
  verifiedAt    DateTime?
  createdAt     DateTime          @default(now())

  @@unique([type, hashAlgorithm, valueHash])
  @@index([dogId, type])
}

model DogEmergencyContact {
  id        String   @id @default(cuid())
  dogId     String
  dog       Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  relation  String?
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dogId, priority])
}

model ConsentGrant {
  id          String      @id @default(cuid())
  dogId       String
  dog         Dog         @relation(fields: [dogId], references: [id], onDelete: Cascade)
  type        ConsentType
  granted     Boolean
  grantedById String
  grantedBy   User        @relation("ConsentGrantor", fields: [grantedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([dogId, type])
  @@index([grantedById, createdAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId, createdAt])
  @@index([userId, createdAt])
}

model DogShareGrant {
  id          String   @id @default(cuid())
  dogId       String
  dog         Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  grantedById String
  grantedBy   User     @relation("DogShareGrantor", fields: [grantedById], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([dogId, expiresAt])
  @@index([grantedById, createdAt])
}

model RecognitionEnrollment {
  id             String                      @id @default(cuid())
  dogId          String
  dog            Dog                         @relation("RecognitionEnrollmentDog", fields: [dogId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User                        @relation("RecognitionEnrollmentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  status         RecognitionEnrollmentStatus @default(PENDING)
  modelVersion   String?
  consentVersion String
  consentedAt    DateTime
  activatedAt    DateTime?
  revokedAt      DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  assets         RecognitionAsset[]

  @@unique([dogId])
  @@index([ownerId, status])
  @@index([status, updatedAt])
}

model RecognitionAsset {
  id            String                 @id @default(cuid())
  enrollmentId  String
  enrollment    RecognitionEnrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  storageKey    String
  contentHash   String
  mimeType      String
  captureView   RecognitionCaptureView?
  status        RecognitionAssetStatus @default(PENDING)
  modelVersion  String?
  embeddingRef  String?
  qualityScore  Float?
  rejectionCode String?
  capturedAt    DateTime?
  processedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([enrollmentId, contentHash])
  @@index([enrollmentId, status])
  @@index([status, createdAt])
}

model RecognitionEvent {
  id             String                  @id @default(cuid())
  requestId      String                  @unique
  source         String
  imageRef       String?
  matchedDogId   String?
  matchedDog     Dog?                    @relation("RecognitionMatchedDog", fields: [matchedDogId], references: [id], onDelete: SetNull)
  confidence     Float?
  outcome        RecognitionEventOutcome
  modelVersion   String
  candidateCount Int                     @default(0)
  latencyMs      Int?
  metadata       Json?
  createdAt      DateTime                @default(now())

  @@index([matchedDogId, createdAt])
  @@index([outcome, createdAt])
  @@index([modelVersion, createdAt])
}

model BuddyRequest {
  id            String             @id @default(cuid())
  senderId      String
  receiverId    String
  sender        User               @relation("SentBuddyRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver      User               @relation("ReceivedBuddyRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status        BuddyRequestStatus @default(PENDING)
  message       String?
  respondedAt   DateTime?
  notifications Notification[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model Buddy {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  userA     User     @relation("BuddyUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("BuddyUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model DogBuddyRequest {
  id            String             @id @default(cuid())
  senderDogId   String
  receiverDogId String
  senderDog     Dog                @relation("SentDogBuddyRequests", fields: [senderDogId], references: [id], onDelete: Cascade)
  receiverDog   Dog                @relation("ReceivedDogBuddyRequests", fields: [receiverDogId], references: [id], onDelete: Cascade)
  status        BuddyRequestStatus @default(PENDING)
  message       String?
  respondedAt   DateTime?
  notifications Notification[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([senderDogId, receiverDogId])
  @@index([receiverDogId, status])
  @@index([senderDogId, status])
}

model DogBuddy {
  id        String   @id @default(cuid())
  dogAId    String
  dogBId    String
  dogA      Dog      @relation("DogBuddyA", fields: [dogAId], references: [id], onDelete: Cascade)
  dogB      Dog      @relation("DogBuddyB", fields: [dogBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([dogAId, dogBId])
  @@index([dogAId])
  @@index([dogBId])
}

model DogPresence {
  id              String            @id @default(cuid())
  dogId           String
  dog             Dog               @relation(fields: [dogId], references: [id], onDelete: Cascade)
  ownerId         String
  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  walkId          String?
  walk            Walk?             @relation(fields: [walkId], references: [id], onDelete: SetNull)
  status          DogPresenceStatus @default(LIKELY_WALKING)
  walkingScore    Int               @default(0)
  latitude        Float
  longitude       Float
  accuracyMeters  Float?
  speedMph        Float?
  heading         Float?
  neighborhoodKey String?
  routeMemoryId   String?
  routeMemory     RouteMemory?      @relation(fields: [routeMemoryId], references: [id], onDelete: SetNull)
  startedAt       DateTime          @default(now())
  lastHeartbeatAt DateTime          @default(now())
  expiresAt       DateTime
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([dogId])
  @@index([dogId, lastHeartbeatAt])
  @@index([ownerId, lastHeartbeatAt])
  // Matches the social-map query exactly: equality on neighborhoodKey, a range on
  // expiresAt, then the lastHeartbeatAt ordering. The previous index led with
  // neighborhoodKey but then status, which that query never constrains, so only the
  // first column was usable and the sort was unsupported.
  @@index([neighborhoodKey, expiresAt, lastHeartbeatAt])
  @@index([latitude, longitude])
}

model RouteMemory {
  id                 String        @id @default(cuid())
  dogId              String
  dog                Dog           @relation(fields: [dogId], references: [id], onDelete: Cascade)
  name               String
  neighborhoodKey    String?
  routeHash          String
  routeGeometry      Json
  routeSteps         Json?
  routeDistanceMiles Float?
  routeDurationMin   Int?
  occurrences        Int           @default(1)
  lastWalkedAt       DateTime      @default(now())
  confidence         Int           @default(50)
  presences          DogPresence[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([dogId, routeHash])
  @@index([dogId, occurrences])
  @@index([neighborhoodKey, lastWalkedAt])
}

model MapReport {
  id              String        @id @default(cuid())
  reporterId      String
  reporter        User          @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  dogId           String?
  dog             Dog?          @relation(fields: [dogId], references: [id], onDelete: SetNull)
  type            MapReportType
  title           String
  body            String?
  latitude        Float
  longitude       Float
  neighborhoodKey String?
  confirmations   Int           @default(0)
  expiresAt       DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([type, expiresAt])
  @@index([neighborhoodKey, expiresAt])
  @@index([latitude, longitude])
}

model QrScan {
  id        String   @id @default(cuid())
  dogId     String
  dog       Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  latitude  Float?
  longitude Float?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([dogId, createdAt])
}

model Sighting {
  id            String         @id @default(cuid())
  dogId         String
  dog           Dog            @relation(fields: [dogId], references: [id], onDelete: Cascade)
  note          String?
  latitude      Float
  longitude     Float
  notifications Notification[]
  createdAt     DateTime       @default(now())

  @@index([dogId, createdAt])
}

model Walk {
  id                 String           @id @default(cuid())
  dogId              String
  dog                Dog              @relation(fields: [dogId], references: [id], onDelete: Cascade)
  requesterId        String
  requester          User             @relation("RequesterWalks", fields: [requesterId], references: [id])
  walkerId           String?
  walker             User?            @relation("WalkerWalks", fields: [walkerId], references: [id])
  startsAt           DateTime
  durationMin        Int
  status             WalkStatus       @default(REQUESTED)
  notes              String?
  routeName          String?
  routeEngine        String?
  routeGeometry      Json?
  routeSteps         Json?
  routeDistanceMiles Float?
  routeDurationMin   Int?
  messages           Message[]
  invitations        WalkInvitation[]
  notifications      Notification[]
  presences          DogPresence[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([dogId, startsAt])
  @@index([walkerId, status])
}

model FavoriteRoute {
  id                 String   @id @default(cuid())
  ownerId            String
  owner              User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  dogId              String?
  dog                Dog?     @relation(fields: [dogId], references: [id], onDelete: SetNull)
  name               String
  routeEngine        String?
  plan               Json
  routeGeometry      Json
  routeSteps         Json?
  routeDistanceMiles Float?
  routeDurationMin   Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([ownerId, createdAt])
  @@index([dogId])
}

model WalkInvitation {
  id            String               @id @default(cuid())
  walkId        String
  walk          Walk                 @relation(fields: [walkId], references: [id], onDelete: Cascade)
  senderDogId   String
  senderDog     Dog                  @relation("WalkInviteSenderDog", fields: [senderDogId], references: [id], onDelete: Cascade)
  invitedDogId  String
  invitedDog    Dog                  @relation("WalkInviteInvitedDog", fields: [invitedDogId], references: [id], onDelete: Cascade)
  status        WalkInvitationStatus @default(PENDING)
  message       String?
  respondedAt   DateTime?
  notifications Notification[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([walkId, invitedDogId])
  @@index([senderDogId, status])
  @@index([invitedDogId, status])
}

model Notification {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              NotificationType
  routeKey          String
  href              String
  title             String
  body              String?
  dogId             String?
  dog               Dog?            @relation(fields: [dogId], references: [id], onDelete: SetNull)
  walkId            String?
  walk              Walk?           @relation(fields: [walkId], references: [id], onDelete: SetNull)
  walkInvitationId  String?
  walkInvitation    WalkInvitation? @relation(fields: [walkInvitationId], references: [id], onDelete: SetNull)
  buddyRequestId    String?
  buddyRequest      BuddyRequest?    @relation(fields: [buddyRequestId], references: [id], onDelete: SetNull)
  dogBuddyRequestId String?
  dogBuddyRequest   DogBuddyRequest? @relation(fields: [dogBuddyRequestId], references: [id], onDelete: SetNull)
  sightingId        String?
  sighting          Sighting?        @relation(fields: [sightingId], references: [id], onDelete: SetNull)
  messageId         String?
  message           Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  readAt            DateTime?
  createdAt         DateTime          @default(now())

  @@index([userId, readAt, createdAt])
  @@index([routeKey, createdAt])
  @@index([dogId])
  @@index([walkId])
  @@index([dogBuddyRequestId])
  @@index([messageId])
}

model Message {
  id            String         @id @default(cuid())
  walkId        String
  walk          Walk           @relation(fields: [walkId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User           @relation(fields: [senderId], references: [id])
  body          String
  notifications Notification[]
  createdAt     DateTime       @default(now())

  @@index([walkId, createdAt])
}

model VetRecord {
  id          String   @id @default(cuid())
  dogId       String
  dog         Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  recordType  String?
  notes       String?
  documentUrl String?
  dueAt       DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dogId, dueAt])
  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Phase 2 Social
//
// These tables were created by 20260831_01_phase2_social_foundation and were
// never declared here. Prisma computes migration diffs against this file, so a
// `prisma migrate dev` run would have generated a migration DROPping all of
// them. The declarations below describe the tables exactly as that migration
// built them -- column types, defaults, FK actions and index names all match --
// so this change is descriptive and produces no DDL.
//
// updatedAt columns are `@default(now())` rather than `@updatedAt` because the
// migration created them with DEFAULT CURRENT_TIMESTAMP and no trigger. Adding
// `@updatedAt` would be a behaviour change and belongs in its own commit.
// ---------------------------------------------------------------------------

model SocialPrivacy {
  userId             String   @id
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  discoverable       Boolean  @default(true)
  showCity           Boolean  @default(true)
  allowBuddyRequests Boolean  @default(true)
  allowWalkInvites   Boolean  @default(true)
  allowMessages      Boolean  @default(true)
  showCheckIns       Boolean  @default(true)
  showActivity       Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())
}

model SocialBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("SocialBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("SocialBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model CheckIn {
  id        String   @id @default(cuid())
  dogId     String
  dog       Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeName String
  latitude  Float
  longitude Float
  note      String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([dogId, createdAt])
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([latitude, longitude])
}

model Conversation {
  id        String               @id @default(cuid())
  kind      String               @default("DIRECT")
  title     String?
  members   ConversationMember[]
  messages  SocialMessage[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @default(now())
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER")
  lastReadAt     DateTime?
  mutedAt        DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId, joinedAt])
}

model SocialMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  // Visible dog authorship (20260904_01_sender_dog_social_messages). senderId stays the
  // authenticated security principal; senderDogId is display identity only.
  senderDogId    String?
  senderDog      Dog?         @relation("SocialMessageSenderDog", fields: [senderDogId], references: [id], onDelete: SetNull)
  recipientDogId String?
  recipientDog   Dog?         @relation("SocialMessageRecipientDog", fields: [recipientDogId], references: [id], onDelete: SetNull)
  body           String
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([senderDogId, createdAt])
  @@index([recipientDogId, createdAt])
}

model SocialGroup {
  id          String              @id @default(cuid())
  ownerId     String
  owner       User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  city        String?
  visibility  String              @default("PUBLIC")
  members     SocialGroupMember[]
  events      SocialEvent[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now())

  @@index([ownerId, createdAt])
  @@index([city, visibility])
}

model SocialGroupMember {
  id       String      @id @default(cuid())
  groupId  String
  group    SocialGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String      @default("MEMBER")
  joinedAt DateTime    @default(now())

  @@unique([groupId, userId])
  @@index([userId, joinedAt])
}

model ActivityFeedItem {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  dogId      String?
  dog        Dog?     @relation(fields: [dogId], references: [id], onDelete: SetNull)
  type       String
  targetType String?
  targetId   String?
  audience   String   @default("BUDDIES")
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([dogId, createdAt])
  @@index([audience, createdAt])
}

model SocialEvent {
  id           String                @id @default(cuid())
  hostId       String
  host         User                  @relation(fields: [hostId], references: [id], onDelete: Cascade)
  groupId      String?
  group        SocialGroup?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  locationName String?
  latitude     Float?
  longitude    Float?
  startsAt     DateTime
  endsAt       DateTime?
  visibility   String                @default("PUBLIC")
  maxAttendees Int?
  attendees    SocialEventAttendee[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @default(now())

  @@index([hostId, startsAt])
  @@index([groupId, startsAt])
  @@index([visibility, startsAt])
}

model SocialEventAttendee {
  id        String      @id @default(cuid())
  eventId   String
  event     SocialEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String      @default("GOING")
  createdAt DateTime    @default(now())

  @@unique([eventId, userId])
  @@index([userId, createdAt])
}

model ReputationEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("ReputationSubject", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("ReputationActor", fields: [actorId], references: [id], onDelete: SetNull)
  kind      String
  points    Int      @default(0)
  reason    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model ModerationReport {
  id           String   @id @default(cuid())
  reporterId   String
  reporter     User     @relation("ModerationReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUserId String?
  targetUser   User?    @relation("ModerationTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetDogId  String?
  targetDog    Dog?     @relation(fields: [targetDogId], references: [id], onDelete: SetNull)
  targetType   String
  targetId     String?
  category     String
  details      String?
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  @@index([reporterId, createdAt])
  @@index([status, createdAt])
  @@index([targetUserId, createdAt])
}

// Additive Meta integration storage. No existing tables are rewritten.
model MetaConnection {
  providerUserId String
  id             String         @id @default(cuid())
  ownerId        String
  owner          User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  platform       String
  externalId     String
  label          String
  token          String
  expiresAt      DateTime
  scopes         String[]
  enabled        Boolean        @default(false)
  contacts       MetaContact[]
  deliveries     MetaDelivery[]
  createdAt      DateTime       @default(now())

  @@unique([platform, externalId])
  @@index([providerUserId])
  @@index([ownerId])
}

model MetaOAuthState {
  hash        String   @id
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  browserHash String
  purpose     String
  expiresAt   DateTime
}

model MetaContact {
  id              String         @id @default(cuid())
  connectionId    String
  connection      MetaConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalId      String
  lastInboundAt   DateTime
  optedInAt       DateTime?
  consentEvidence String?

  @@unique([connectionId, externalId])
}

model MetaDelivery {
  senderDogId  String
  senderDog    Dog            @relation(fields: [senderDogId], references: [id], onDelete: Cascade)
  id           String         @id
  connectionId String
  connection   MetaConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  status       String         @default("PENDING")
  providerId   String?
  createdAt    DateTime       @default(now())
}

model MetaWebhook {
  hash       String   @id
  receivedAt DateTime @default(now())
}

model MetaRateBucket {
  id        String   @id
  count     Int      @default(1)
  expiresAt DateTime
}

model MetaShare {
  id        String   @id
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title     String
  expiresAt DateTime
}
