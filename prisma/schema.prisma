generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  WALKER
  ADMIN
}

enum DogCustodianRole {
  OWNER
  CAREGIVER
  WALKER
  VIEWER
}

enum DogIdentifierType {
  QR
  MICROCHIP
  VISUAL_RECOGNITION
  NFC
  BLE
}

enum ConsentType {
  LOCATION_SHARING
  MEDICAL_ACCESS
  SCANNER_DISCLOSURE
  MARKETPLACE_ACCESS
  PHOTO_USAGE
  RECOGNITION_ENROLLMENT
}

enum DogStatus {
  SAFE
  LOST
  FOUND
}

enum WalkStatus {
  REQUESTED
  ACCEPTED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BuddyRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum WalkInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum NotificationType {
  BUDDY_REQUEST
  WALK_INVITE
  WALK_STATUS
  MESSAGE
  DOG_LOST
  DOG_FOUND
  DOG_SIGHTING
  VET_REMINDER
  SYSTEM
}

enum DogPresenceStatus {
  NOT_ACTIVE
  LIKELY_WALKING
  WALKING
  PAUSED
  STALE
  POSSIBLY_DRIVING
}

enum MapReportType {
  FRIENDLY_GROUP
  LOOSE_DOG
  AGGRESSIVE_DOG
  WATER_BOWL
  POOP_BAG_STATION
  HAZARD
  CROWDED_PARK
  LOST_SIGHTING
}

enum RecognitionCaptureView {
  FRONT_LEFT
  FRONT_CENTER
  FRONT_RIGHT
  REAR_LEFT
  REAR_CENTER
  REAR_RIGHT
  LEFT_HEAD_ON
  RIGHT_HEAD_ON
}

enum RecognitionEnrollmentStatus {
  PENDING
  ACTIVE
  PAUSED
  REVOKED
}

enum RecognitionAssetStatus {
  PENDING
  PROCESSING
  READY
  REJECTED
  DELETED
}

enum RecognitionEventOutcome {
  MATCH
  LOW_CONFIDENCE
  NO_MATCH
  ERROR
}

enum DogPackMemberStatus {
  INVITED
  REQUESTED
  ACCEPTED
  DECLINED
  LEFT
}

model User {
  id                       String                  @id @default(cuid())
  clerkId                  String?                 @unique
  email                    String                  @unique
  displayName              String
  passwordHash             String?
  role                     UserRole                @default(OWNER)
  emailVerifiedAt          DateTime?
  sessionVersion           Int                     @default(0)
  avatarUrl                String?
  bio                      String?
  city                     String?
  phone                    String?
  latitude                 Float?
  longitude                Float?
  dogs                     Dog[]
  preferences              UserPreference?
  householdMemberships     HouseholdMember[]
  custodianships           DogCustodian[]
  grantedConsents          ConsentGrant[]          @relation("ConsentGrantor")
  grantedShares            DogShareGrant[]         @relation("DogShareGrantor")
  auditEvents              AuditEvent[]
  recognitionEnrollments   RecognitionEnrollment[] @relation("RecognitionEnrollmentOwner")
  reportedRecognitionEvents RecognitionEvent[]     @relation("RecognitionEventReporter")
  recognitionMatchMessages  RecognitionMatchMessage[] @relation("RecognitionMatchMessageSender")
  personalAccessTokens      PersonalAccessToken[]
  sentWalks                Walk[]                  @relation("RequesterWalks")
  assignedWalks            Walk[]                  @relation("WalkerWalks")
  messages                 Message[]
  vetRecords               VetRecord[]
  favoriteRoutes           FavoriteRoute[]
  notifications            Notification[]
  sentBuddyRequests        BuddyRequest[]          @relation("SentBuddyRequests")
  receivedBuddyRequests    BuddyRequest[]          @relation("ReceivedBuddyRequests")
  buddyLinksA              Buddy[]                 @relation("BuddyUserA")
  buddyLinksB              Buddy[]                 @relation("BuddyUserB")
  dogPresences             DogPresence[]
  mapReports               MapReport[]
  socialPrivacy            SocialPrivacy?
  socialBlocksMade         SocialBlock[]           @relation("SocialBlocker")
  socialBlocksReceived     SocialBlock[]           @relation("SocialBlocked")
  checkIns                 CheckIn[]
  conversationMemberships  ConversationMember[]
  socialMessages           SocialMessage[]
  ownedSocialGroups        SocialGroup[]
  socialGroupMemberships   SocialGroupMember[]
  ownedDogPacks            DogPack[]
  dogPackMemberships       DogPackMember[]
  activityFeedItems        ActivityFeedItem[]
  hostedSocialEvents       SocialEvent[]
  socialEventAttendance    SocialEventAttendee[]
  reputationEvents         ReputationEvent[]       @relation("ReputationSubject")
  reputationActions        ReputationEvent[]       @relation("ReputationActor")
  moderationReportsFiled   ModerationReport[]      @relation("ModerationReporter")
  moderationReportsAgainst ModerationReport[]      @relation("ModerationTargetUser")
  metaConnections          MetaConnection[]
  metaOAuthStates          MetaOAuthState[]
  metaShares               MetaShare[]
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
}

// A long-lived bearer credential a user generates in their account settings to let an
// external MCP client (e.g. a ChatGPT connector) act as them against /api/mcp. Only the
// SHA-256 hash is stored; the plaintext token is shown once, at creation time, and never
// persisted or logged.
model PersonalAccessToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId, revokedAt])
}

model UserPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme               String   @default("system")
  locale              String   @default("en")
  marketingEmails     Boolean  @default(false)
  safetyAlerts        Boolean  @default(true)
  marketplaceMessages Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Household {
  id        String            @id @default(cuid())
  name      String
  members   HouseholdMember[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model HouseholdMember {
  id          String    @id @default(cuid())
  householdId String
  userId      String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([householdId, userId])
  @@index([userId])
}

model DogCustodian {
  id        String           @id @default(cuid())
  dogId     String
  userId    String
  role      DogCustodianRole @default(VIEWER)
  dog       Dog              @relation(fields: [dogId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([dogId, userId])
  @@index([userId, role])
  @@index([dogId, role])
}

model Dog {
  id                       String                  @id @default(cuid())
  ownerId                  String
  owner                    User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                     String
  slug                     String                  @unique
  publicId                 String?                 @default(cuid())
  breed                    String?
  birthDate                DateTime?
  weightLbs                Int?
  gender                   String?
  photoUrl                 String?
  status                   DogStatus               @default(SAFE)
  temperament              String?
  medicalNotes             String?
  vaccinationNotes         String?
  emergencyContact         String?
  lostSince                DateTime?
  lastSeenLocation         String?
  lostReward               String?
  lostNotes                String?
  spayedNeutered           Boolean                 @default(false)
  friendlyDogs             Boolean                 @default(true)
  friendlyCats             Boolean                 @default(false)
  friendlyChildren         Boolean                 @default(true)
  latitude                 Float?
  longitude                Float?
  custodians               DogCustodian[]
  media                    DogMedia[]
  medicalProfile           DogMedicalProfile?
  vaccinations             Vaccination[]
  identifiers              DogIdentifier[]
  emergencyContacts        DogEmergencyContact[]
  consents                 ConsentGrant[]
  shareGrants              DogShareGrant[]
  recognitionEnrollment    RecognitionEnrollment?  @relation("RecognitionEnrollmentDog")
  recognitionEvents        RecognitionEvent[]      @relation("RecognitionMatchedDog")
  recognitionCandidacies   RecognitionEventCandidate[] @relation("RecognitionEventCandidateDog")
  recognitionMatchMessages RecognitionMatchMessage[]   @relation("RecognitionMatchMessageDog")
  qrScans                  QrScan[]
  sightings                Sighting[]
  walks                    Walk[]
  vetRecords               VetRecord[]
  favoriteRoutes           FavoriteRoute[]
  sentWalkInvitations      WalkInvitation[]        @relation("WalkInviteSenderDog")
  receivedWalkInvitations  WalkInvitation[]        @relation("WalkInviteInvitedDog")
  sentDogBuddyRequests     DogBuddyRequest[]       @relation("SentDogBuddyRequests")
  receivedDogBuddyRequests DogBuddyRequest[]       @relation("ReceivedDogBuddyRequests")
  dogBuddyLinksA           DogBuddy[]              @relation("DogBuddyA")
  dogBuddyLinksB           DogBuddy[]              @relation("DogBuddyB")
  presences                DogPresence[]
  routeMemories            RouteMemory[]
  mapReports               MapReport[]
  notifications            Notification[]
  checkIns                 CheckIn[]
  activityFeedItems        ActivityFeedItem[]
  socialMessages           SocialMessage[]         @relation("SocialMessageSenderDog")
  receivedSocialMessages   SocialMessage[]         @relation("SocialMessageRecipientDog")
  dogPackMemberships       DogPackMember[]
  metaDeliveries           MetaDelivery[]
  moderationReports        ModerationReport[]
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([publicId])
}

model DogMedia {
  id        String   @id @default(cuid())
  dogId     String
  dog       Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  kind      String   @default("PHOTO")
  url       String
  width     Int?
  height    Int?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([dogId, isPrimary])
  @@index([dogId, createdAt])
}

model DogMedicalProfile {
  id                  String   @id @default(cuid())
  dogId               String   @unique
  dog                 Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  allergies           String?
  medications         String?
  conditions          String?
  dietaryRestrictions String?
  veterinarianName    String?
  veterinarianPhone   String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Vaccination {
  id             String   @id @default(cuid())
  dogId          String
  dog            Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  name           String
  administeredAt DateTime?
  expiresAt      DateTime?
  documentUrl    String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([dogId, expiresAt])
  @@index([dogId, name])
}

model DogIdentifier {
  id            String            @id @default(cuid())
  dogId         String
  dog           Dog               @relation(fields: [dogId], references: [id], onDelete: Cascade)
  type          DogIdentifierType
  hashAlgorithm String            @default("sha256")
  valueHash     String
  label         String?
  verifiedAt    DateTime?
  createdAt     DateTime          @default(now())

  @@unique([type, hashAlgorithm, valueHash])
  @@index([dogId, type])
}

model DogEmergencyContact {
  id        String   @id @default(cuid())
  dogId     String
  dog       Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  relation  String?
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dogId, priority])
}

model ConsentGrant {
  id          String      @id @default(cuid())
  dogId       String
  dog         Dog         @relation(fields: [dogId], references: [id], onDelete: Cascade)
  type        ConsentType
  granted     Boolean
  grantedById String
  grantedBy   User        @relation("ConsentGrantor", fields: [grantedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([dogId, type])
  @@index([grantedById, createdAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId, createdAt])
  @@index([userId, createdAt])
}

model DogShareGrant {
  id          String   @id @default(cuid())
  dogId       String
  dog         Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  grantedById String
  grantedBy   User     @relation("DogShareGrantor", fields: [grantedById], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([dogId, expiresAt])
  @@index([grantedById, createdAt])
}

model RecognitionEnrollment {
  id             String                      @id @default(cuid())
  dogId          String
  dog            Dog                         @relation("RecognitionEnrollmentDog", fields: [dogId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User                        @relation("RecognitionEnrollmentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  status         RecognitionEnrollmentStatus @default(PENDING)
  modelVersion   String?
  consentVersion String
  consentedAt    DateTime
  activatedAt    DateTime?
  revokedAt      DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  assets         RecognitionAsset[]

  @@unique([dogId])
  @@index([ownerId, status])
  @@index([status, updatedAt])
}

model RecognitionAsset {
  id            String                 @id @default(cuid())
  enrollmentId  String
  enrollment    RecognitionEnrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  storageKey    String
  contentHash   String
  mimeType      String
  captureView   RecognitionCaptureView?
  status        RecognitionAssetStatus @default(PENDING)
  modelVersion  String?
  embeddingRef  String?
  qualityScore  Float?
  rejectionCode String?
  capturedAt    DateTime?
  processedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([enrollmentId, contentHash])
  @@index([enrollmentId, status])
  @@index([status, createdAt])
}

model RecognitionEvent {
  id              String                      @id @default(cuid())
  requestId       String                      @unique
  source          String
  imageRef        String?
  matchedDogId    String?
  matchedDog      Dog?                        @relation("RecognitionMatchedDog", fields: [matchedDogId], references: [id], onDelete: SetNull)
  confidence      Float?
  outcome         RecognitionEventOutcome
  modelVersion    String
  candidateCount  Int                         @default(0)
  latencyMs       Int?
  metadata        Json?
  // The signed-in user who submitted the one-time search photo (the "finder"), so a
  // matched owner has someone to contact. Null for non-search recognition events.
  reporterUserId  String?
  reporter        User?                       @relation("RecognitionEventReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  // The uploaded photo, retained only long enough for a matched owner to review it.
  // Never set when a search finds no candidates.
  photoStorageKey String?
  photoExpiresAt  DateTime?
  candidates      RecognitionEventCandidate[]
  matchMessages   RecognitionMatchMessage[]
  createdAt       DateTime                    @default(now())

  @@index([matchedDogId, createdAt])
  @@index([outcome, createdAt])
  @@index([modelVersion, createdAt])
  @@index([photoExpiresAt])
}

// One row per dog a lost-dog search matched above threshold. Durable, explicit record of
// "this dog's owner and this event's reporter are allowed to see this match and message
// each other" — independent of the Notification rows, which are for UI alerting only and
// are not meant to be relied on for authorization.
model RecognitionEventCandidate {
  id                 String           @id @default(cuid())
  recognitionEventId String
  recognitionEvent   RecognitionEvent @relation(fields: [recognitionEventId], references: [id], onDelete: Cascade)
  dogId              String
  dog                Dog              @relation("RecognitionEventCandidateDog", fields: [dogId], references: [id], onDelete: Cascade)
  score              Float
  createdAt          DateTime         @default(now())

  @@unique([recognitionEventId, dogId])
  @@index([dogId, createdAt])
}

// A small, dedicated contact thread between a matched dog's owner and the search's
// reporter, scoped to one (event, dog) pair. Deliberately not reusing SocialMessage: that
// system requires both participants to own a dog, which a finder frequently will not.
model RecognitionMatchMessage {
  id                 String           @id @default(cuid())
  recognitionEventId String
  recognitionEvent   RecognitionEvent @relation(fields: [recognitionEventId], references: [id], onDelete: Cascade)
  dogId              String
  dog                Dog              @relation("RecognitionMatchMessageDog", fields: [dogId], references: [id], onDelete: Cascade)
  senderId           String
  sender             User             @relation("RecognitionMatchMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body               String
  createdAt          DateTime         @default(now())

  @@index([recognitionEventId, dogId, createdAt])
  @@index([senderId, createdAt])
}

model BuddyRequest {
  id            String             @id @default(cuid())
  senderId      String
  receiverId    String
  sender        User               @relation("SentBuddyRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver      User               @relation("ReceivedBuddyRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status        BuddyRequestStatus @default(PENDING)
  message       String?
  respondedAt   DateTime?
  notifications Notification[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model Buddy {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  userA     User     @relation("BuddyUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("BuddyUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model DogBuddyRequest {
  id            String             @id @default(cuid())
  senderDogId   String
  receiverDogId String
  senderDog     Dog                @relation("SentDogBuddyRequests", fields: [senderDogId], references: [id], onDelete: Cascade)
  receiverDog   Dog                @relation("ReceivedDogBuddyRequests", fields: [receiverDogId], references: [id], onDelete: Cascade)
  status        BuddyRequestStatus @default(PENDING)
  message       String?
  respondedAt   DateTime?
  notifications Notification[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([senderDogId, receiverDogId])
  @@index([receiverDogId, status])
  @@index([senderDogId, status])
}

model DogBuddy {
  id        String   @id @default(cuid())
  dogAId    String
  dogBId    String
  dogA      Dog      @relation("DogBuddyA", fields: [dogAId], references: [id], onDelete: Cascade)
  dogB      Dog      @relation("DogBuddyB", fields: [dogBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([dogAId, dogBId])
  @@index([dogAId])
  @@index([dogBId])
}

model DogPresence {
  id              String            @id @default(cuid())
  dogId           String
  dog             Dog               @relation(fields: [dogId], references: [id], onDelete: Cascade)
  ownerId         String
  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  walkId          String?
  walk            Walk?             @relation(fields: [walkId], references: [id], onDelete: SetNull)
  status          DogPresenceStatus @default(LIKELY_WALKING)
  walkingScore    Int               @default(0)
  latitude        Float
  longitude       Float
  accuracyMeters  Float?
  speedMph        Fl…4530 tokens truncated…DogId], references: [id], onDelete: SetNull)
  targetType   String
  targetId     String?
  category     String
  details      String?
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  @@index([reporterId, createdAt])
  @@index([status, createdAt])
  @@index([targetUserId, createdAt])
}

// Additive Meta integration storage. No existing tables are rewritten.
model MetaConnection {
  providerUserId String
  id             String         @id @default(cuid())
  ownerId        String
  owner          User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  platform       String
  externalId     String
  label          String
  token          String
  expiresAt      DateTime
  scopes         String[]
  enabled        Boolean        @default(false)
  contacts       MetaContact[]
  deliveries     MetaDelivery[]
  createdAt      DateTime       @default(now())

  @@unique([platform, externalId])
  @@index([providerUserId])
  @@index([ownerId])
}

model MetaOAuthState {
  hash        String   @id
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  browserHash String
  purpose     String
  expiresAt   DateTime
}

model MetaContact {
  id              String         @id @default(cuid())
  connectionId    String
  connection      MetaConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalId      String
  lastInboundAt   DateTime
  optedInAt       DateTime?
  consentEvidence String?

  @@unique([connectionId, externalId])
}

model MetaDelivery {
  senderDogId  String
  senderDog    Dog            @relation(fields: [senderDogId], references: [id], onDelete: Cascade)
  id           String         @id
  connectionId String
  connection   MetaConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  status       String         @default("PENDING")
  providerId   String?
  createdAt    DateTime       @default(now())
}

model MetaWebhook {
  hash       String   @id
  receivedAt DateTime @default(now())
}

model MetaRateBucket {
  id        String   @id
  count     Int      @default(1)
  expiresAt DateTime
}

model MetaShare {
  id        String   @id
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title     String
  expiresAt DateTime
}
