generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  OWNER
  WALKER
  ADMIN
}

enum DogStatus {
  SAFE
  LOST
  FOUND
}

enum WalkStatus {
  REQUESTED
  ACCEPTED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BuddyRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum WalkInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum NotificationType {
  BUDDY_REQUEST
  WALK_INVITE
  WALK_STATUS
  MESSAGE
  DOG_LOST
  DOG_FOUND
  DOG_SIGHTING
  VET_REMINDER
  SYSTEM
}

model User {
  id                    String          @id @default(cuid())
  email                 String          @unique
  displayName           String
  passwordHash          String?
  role                  UserRole        @default(OWNER)
  emailVerifiedAt       DateTime?
  avatarUrl             String?
  bio                    String?
  city                   String?
  phone                  String?
  latitude               Float?
  longitude              Float?
  dogs                   Dog[]
  sentWalks              Walk[]          @relation("RequesterWalks")
  assignedWalks          Walk[]          @relation("WalkerWalks")
  messages               Message[]
  vetRecords             VetRecord[]
  favoriteRoutes         FavoriteRoute[]
  notifications          Notification[]
  sentBuddyRequests      BuddyRequest[]  @relation("SentBuddyRequests")
  receivedBuddyRequests  BuddyRequest[]  @relation("ReceivedBuddyRequests")
  buddyLinksA            Buddy[]         @relation("BuddyUserA")
  buddyLinksB            Buddy[]         @relation("BuddyUserB")
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

model Dog {
  id                       String             @id @default(cuid())
  ownerId                  String
  owner                    User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                     String
  slug                     String             @unique
  publicId                 String?            @default(cuid())
  breed                    String?
  birthDate                DateTime?
  weightLbs                Int?
  gender                   String?
  photoUrl                 String?
  status                   DogStatus          @default(SAFE)
  temperament              String?
  medicalNotes             String?
  vaccinationNotes         String?
  emergencyContact         String?
  lostSince                DateTime?
  lastSeenLocation         String?
  lostReward               String?
  lostNotes                String?
  spayedNeutered           Boolean            @default(false)
  friendlyDogs             Boolean            @default(true)
  friendlyCats             Boolean            @default(false)
  friendlyChildren         Boolean            @default(true)
  latitude                 Float?
  longitude                Float?
  qrScans                  QrScan[]
  sightings                Sighting[]
  walks                    Walk[]
  vetRecords               VetRecord[]
  favoriteRoutes           FavoriteRoute[]
  sentWalkInvitations      WalkInvitation[]   @relation("WalkInviteSenderDog")
  receivedWalkInvitations  WalkInvitation[]   @relation("WalkInviteInvitedDog")
  sentDogBuddyRequests     DogBuddyRequest[]  @relation("SentDogBuddyRequests")
  receivedDogBuddyRequests DogBuddyRequest[]  @relation("ReceivedDogBuddyRequests")
  dogBuddyLinksA           DogBuddy[]         @relation("DogBuddyA")
  dogBuddyLinksB           DogBuddy[]         @relation("DogBuddyB")
  notifications            Notification[]
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([publicId])
}

model BuddyRequest {
  id            String             @id @default(cuid())
  senderId      String
  receiverId    String
  sender        User               @relation("SentBuddyRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver      User               @relation("ReceivedBuddyRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status        BuddyRequestStatus @default(PENDING)
  message       String?
  respondedAt   DateTime?
  notifications Notification[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model Buddy {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  userA     User     @relation("BuddyUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("BuddyUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model DogBuddyRequest {
  id            String             @id @default(cuid())
  senderDogId   String
  receiverDogId String
  senderDog     Dog                @relation("SentDogBuddyRequests", fields: [senderDogId], references: [id], onDelete: Cascade)
  receiverDog   Dog                @relation("ReceivedDogBuddyRequests", fields: [receiverDogId], references: [id], onDelete: Cascade)
  status        BuddyRequestStatus @default(PENDING)
  message       String?
  respondedAt   DateTime?
  notifications Notification[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([senderDogId, receiverDogId])
  @@index([receiverDogId, status])
  @@index([senderDogId, status])
}

model DogBuddy {
  id        String   @id @default(cuid())
  dogAId    String
  dogBId    String
  dogA      Dog      @relation("DogBuddyA", fields: [dogAId], references: [id], onDelete: Cascade)
  dogB      Dog      @relation("DogBuddyB", fields: [dogBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([dogAId, dogBId])
  @@index([dogAId])
  @@index([dogBId])
}

model QrScan {
  id        String   @id @default(cuid())
  dogId     String
  dog       Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  latitude  Float?
  longitude Float?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([dogId, createdAt])
}

model Sighting {
  id            String         @id @default(cuid())
  dogId         String
  dog           Dog            @relation(fields: [dogId], references: [id], onDelete: Cascade)
  note          String?
  latitude      Float
  longitude     Float
  notifications Notification[]
  createdAt     DateTime       @default(now())

  @@index([dogId, createdAt])
}

model Walk {
  id                 String           @id @default(cuid())
  dogId              String
  dog                Dog              @relation(fields: [dogId], references: [id], onDelete: Cascade)
  requesterId        String
  requester          User             @relation("RequesterWalks", fields: [requesterId], references: [id])
  walkerId           String?
  walker             User?            @relation("WalkerWalks", fields: [walkerId], references: [id])
  startsAt           DateTime
  durationMin        Int
  status             WalkStatus       @default(REQUESTED)
  notes              String?
  routeName          String?
  routeEngine        String?
  routeGeometry      Json?
  routeSteps         Json?
  routeDistanceMiles Float?
  routeDurationMin   Int?
  messages           Message[]
  invitations        WalkInvitation[]
  notifications      Notification[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([dogId, startsAt])
  @@index([walkerId, status])
}

model FavoriteRoute {
  id                 String   @id @default(cuid())
  ownerId            String
  owner              User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  dogId              String?
  dog                Dog?     @relation(fields: [dogId], references: [id], onDelete: SetNull)
  name               String
  routeEngine        String?
  plan               Json
  routeGeometry      Json
  routeSteps         Json?
  routeDistanceMiles Float?
  routeDurationMin   Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([ownerId, createdAt])
  @@index([dogId])
}

model WalkInvitation {
  id            String               @id @default(cuid())
  walkId        String
  walk          Walk                 @relation(fields: [walkId], references: [id], onDelete: Cascade)
  senderDogId   String
  senderDog     Dog                  @relation("WalkInviteSenderDog", fields: [senderDogId], references: [id], onDelete: Cascade)
  invitedDogId  String
  invitedDog    Dog                  @relation("WalkInviteInvitedDog", fields: [invitedDogId], references: [id], onDelete: Cascade)
  status        WalkInvitationStatus @default(PENDING)
  message       String?
  respondedAt   DateTime?
  notifications Notification[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([walkId, invitedDogId])
  @@index([senderDogId, status])
  @@index([invitedDogId, status])
}

model Notification {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               NotificationType
  routeKey           String
  href               String
  title              String
  body               String?
  dogId              String?
  dog                Dog?              @relation(fields: [dogId], references: [id], onDelete: SetNull)
  walkId             String?
  walk               Walk?             @relation(fields: [walkId], references: [id], onDelete: SetNull)
  walkInvitationId   String?
  walkInvitation     WalkInvitation?    @relation(fields: [walkInvitationId], references: [id], onDelete: SetNull)
  buddyRequestId     String?
  buddyRequest       BuddyRequest?      @relation(fields: [buddyRequestId], references: [id], onDelete: SetNull)
  dogBuddyRequestId  String?
  dogBuddyRequest    DogBuddyRequest?   @relation(fields: [dogBuddyRequestId], references: [id], onDelete: SetNull)
  sightingId         String?
  sighting           Sighting?          @relation(fields: [sightingId], references: [id], onDelete: SetNull)
  messageId          String?
  message            Message?           @relation(fields: [messageId], references: [id], onDelete: SetNull)
  readAt             DateTime?
  createdAt          DateTime            @default(now())

  @@index([userId, readAt, createdAt])
  @@index([routeKey, createdAt])
  @@index([dogId])
  @@index([walkId])
  @@index([dogBuddyRequestId])
  @@index([messageId])
}

model Message {
  id            String         @id @default(cuid())
  walkId        String
  walk          Walk           @relation(fields: [walkId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User           @relation(fields: [senderId], references: [id])
  body          String
  notifications Notification[]
  createdAt     DateTime       @default(now())

  @@index([walkId, createdAt])
}

model VetRecord {
  id          String   @id @default(cuid())
  dogId       String
  dog         Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  recordType  String?
  notes       String?
  documentUrl String?
  dueAt       DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dogId, dueAt])
  @@index([ownerId])
}
