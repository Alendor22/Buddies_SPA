{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:ci",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": false,
      "preview": true,
      "preview/**": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup-expired",
      "schedule": "0 * * * *"
    }
  ]
}
